DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE List (
        id            STRING,
        name          STRING,
        createdAt     TIMESTAMP,
        updatedAt     TIMESTAMP,
        schemaVersion INT64
    );

    RECORD TYPE Aisle (
        id        STRING,
        name      STRING,
        icon      STRING,
        iconColor STRING,
        orderKey  INT64
    );

    RECORD TYPE Product (
        id                       STRING,
        name                     STRING,
        aliases                  LIST<STRING>,
        uses                     INT64,
        identityKey              STRING,
        hasPreference            INT64,
        preferredAisleID         STRING,
        hasClassification        INT64,
        classificationSuggestion STRING
    );

    RECORD TYPE ListItem (
        id                     STRING,
        productID              STRING,
        note                   STRING,
        aisleID                STRING,
        purchased              INT64,
        suggestion             STRING,
        classificationRevision STRING,
        createdAt              TIMESTAMP,
        orderKey               INT64
    );
